# Copy to .env and edit. .env is git-ignored.

# Login for the Stash web UI. Share these with your testers.
STASH_USERNAME=ember
STASH_PASSWORD=change-me

# Host port Stash listens on.
STASH_PORT=9999

# The address testers will use. Only used in the connection summary the seeder prints.
STASH_PUBLIC_URL=http://localhost:9999

# Pin a Stash version (e.g. v0.31.1) so everyone tests against the same server.
STASH_IMAGE_TAG=latest

# Only needed for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
